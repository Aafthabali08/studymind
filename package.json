{
  "name": "studymind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "vitest run && vite build && firebase deploy --only hosting,firestore:rules",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-studymind",
    "dev:emulators": "vite --mode emulator --host 127.0.0.1",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-studymind \"node scripts/check-rules.mjs\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "docx": "^9.8.1",
    "firebase": "^12.19.0",
    "highlight.js": "^11.12.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^29.1.1",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
