rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // The admin must be signed in with this verified email (Google sign-in
    // counts as verified). Checked by Google's servers, so it cannot be faked.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "aafthabali08@gmail.com"
        && request.auth.token.email_verified == true;
    }
    // Blocked (no end) or suspended until a time, by the admin (bans/{uid}).
    function banned() {
      let ban = /databases/$(database)/documents/bans/$(request.auth.uid);
      return exists(ban)
        && (get(ban).data.until == null || get(ban).data.until > request.time);
    }
    // A signed-in user who is not blocked or suspended.
    function allowed() {
      return signedIn() && !banned();
    }
    // A supporter the admin picked (supporters/{uid}); blocked or suspended
    // supporters lose it too.
    function isSupporter() {
      return allowed()
        && exists(/databases/$(database)/documents/supporters/$(request.auth.uid));
    }
    function isOwner(uid) {
      return allowed() && request.auth.uid == uid;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Profile: the owner writes it; the admin can read and search profiles
    // (email, name, number of documents) but never document contents.
    // Blocks and suspensions: the admin sets them; a user can see their own.
    match /bans/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin()
        && request.resource.data.type in ["blocked", "suspended"]
        && (request.resource.data.type == "blocked" || request.resource.data.until is timestamp);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);

      // Everything else under a user is private to that user.
      match /{path=**} {
        allow read, write: if isOwner(uid);
      }

      // The admin can send a user notifications (ticket updates).
      match /notifications/{id} {
        allow create: if isAdmin();
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) && onlyChanges(["read"]);
        allow delete: if isOwner(uid);
      }
    }

    // Complaint box. Users create and read their own tickets and can add
    // messages; only the admin changes the status. A blocked or suspended
    // user can only raise one-message appeal tickets ("Contact admin"), and
    // can't read or add to them.
    match /tickets/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "open"
        && (!banned()
            || (request.resource.data.appeal == true
                && request.resource.data.subject is string
                && request.resource.data.subject.size() <= 140
                && request.resource.data.messages is list
                && request.resource.data.messages.size() == 1
                && request.resource.data.messages[0].text is string
                && request.resource.data.messages[0].text.size() <= 3000));
      allow read: if isAdmin() || (allowed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        || (allowed() && resource.data.uid == request.auth.uid
            && onlyChanges(["messages", "updatedAt", "unreadForAdmin", "unreadForUser"]));
      // The admin, or the owner when deleting their account.
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Optional pictures on a ticket (compressed in the browser, < 700 KB).
      match /attachments/{attachment} {
        function ticketOwner() {
          return allowed()
            && get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid;
        }
        allow read: if isAdmin() || ticketOwner();
        allow create: if (isAdmin() || ticketOwner())
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/.*')
          && request.resource.data.dataUrl.size() < 700000;
        allow delete: if isAdmin() || ticketOwner();
      }
    }

    // ✓ / ✗ feedback on AI output. Users add their own; the admin reviews.
    match /feedback/{id} {
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (allowed() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Admin guidance added to every Gemini prompt; readable by all users.
    match /app/{doc} {
      allow read: if allowed();
      allow write: if isAdmin();
    }

    // University library: the admin's university / degree / year options and
    // the shared subjects, folders and files (with their text, figures and
    // original). Every signed-in user can read. The admin changes anything;
    // a supporter adds, uploads, edits, transfers and copies (never deletes),
    // and each of their changes must be written together with its audit
    // entry (same batch, so `at` is this request's time).
    // Each user's own notes for a file live under users/{uid}/uniStudy.
    match /uni/{doc} {
      allow read: if allowed();
      allow write: if isAdmin();
    }
    match /uniNodes/{id} {
      function validNode() {
        return request.resource.data.kind in ["subject", "folder", "file"]
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.exam in ["both", "regular", "supply"]
          // Optional icon: a built-in icon name or an emoji.
          && (!("icon" in request.resource.data) || request.resource.data.icon == null
              || (request.resource.data.icon is string && request.resource.data.icon.size() <= 24));
      }
      function auditedBySupporter() {
        let entry = /databases/$(database)/documents/audit/$(request.resource.data.audit);
        return isSupporter()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.audit is string
          && getAfter(entry).data.uid == request.auth.uid
          && getAfter(entry).data.at == request.time;
      }
      allow read: if allowed();
      allow create, update: if validNode() && (isAdmin() || auditedBySupporter());
      allow delete: if isAdmin();
      // A file's parts, images and original chunks (one level below the
      // node; "{sub=**}" would also match the node itself and skip its checks).
      // A supporter writes them only for a new file, before its node exists.
      match /{collection}/{part} {
        allow read: if allowed();
        allow write: if isAdmin();
        allow create: if isSupporter()
          && collection in ["parts", "images", "blobs"]
          && !exists(/databases/$(database)/documents/uniNodes/$(id));
      }
    }

    // Supporters: the admin adds and removes them; a user can see their own.
    match /supporters/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    // Audit log of supporters' library changes: written by the supporter with
    // the change itself, read only by the admin, never edited.
    match /audit/{id} {
      allow create: if isSupporter()
        && request.resource.data.keys().hasOnly(["uid", "email", "name", "action", "summary", "course", "items", "count", "at"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow read, delete: if isAdmin();
    }
  }
}
