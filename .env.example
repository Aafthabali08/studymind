# Copy to .env.local and fill in from Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini (optional). Get a key at https://aistudio.google.com/apikey
# Restrict the key to your site's domain in Google Cloud console -> Credentials,
# because values in a web app are visible to visitors.
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.8-flash
# Or keep the key inside Firebase (Firebase AI Logic) instead of the browser:
# VITE_GEMINI_VIA_FIREBASE=true

# Recommended before going public (both free on the Spark plan):
# 1. Keep the Gemini key inside Firebase: Firebase console -> AI Logic ->
#    Get started -> Gemini Developer API. Then remove VITE_GEMINI_API_KEY and set:
# VITE_GEMINI_VIA_FIREBASE=true
# 2. App Check: Firebase console -> App Check -> register the web app with
#    reCAPTCHA v3, paste its site key here, then enforce App Check for AI Logic.
# VITE_RECAPTCHA_SITE_KEY=
