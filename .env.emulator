# Local testing against the Firebase emulators (npm run emulators, then
# npm run dev:emulators). "demo-" projects never contact Google's servers.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-studymind.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-studymind
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_RECAPTCHA_SITE_KEY=
